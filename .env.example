# Copy to .env (never commit .env). Only the providers you use in config/models.yaml are needed.
# Claude API (Slide Studio + content pipeline). Better: a user environment variable (setx ANTHROPIC_API_KEY ...),
# because the Studio's design agents read the environment, not this file.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Design side plug-in: "package.module:render"  (empty -> python-pptx draft)
P2S_DESIGN_BACKEND=

# Loop limits
P2S_MAX_CONTENT_ROUNDS=2
P2S_MAX_DESIGN_SENDBACKS=1
P2S_CONTENT_WORKERS=2
